#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Add-on: Claude Code
# Runs Claude Code in Remote Control server mode
# ==============================================================================
# shellcheck source=../../../../usr/lib/claude-addon/common.sh
source /usr/lib/claude-addon/common.sh

declare -a options
declare session_name

# Remote Control needs a full claude.ai login. Without it the command exits
# immediately, so the service would otherwise spin in a tight restart loop.
if ! bashio::fs.file_exists '/data/claude/.credentials.json'; then
    bashio::log.warning \
        'Not signed in yet. Open the terminal and run "/login" once;' \
        'Remote Control starts on its own afterwards.'
    sleep 60
    exit 1
fi

readonly DEFAULT_NAME='Home Assistant'

# bashio only falls back to the default for a missing option; an empty or
# blank name would reach Claude Code as --name "".
session_name=$(bashio::config 'remote_control_name' "${DEFAULT_NAME}")
[[ -n "${session_name//[[:space:]]/}" ]] || session_name="${DEFAULT_NAME}"

options+=(--spawn same-dir)
options+=(--name "${session_name}")
# --name only covers the session created at start. Sessions opened later from
# claude.ai get a generated name whose prefix defaults to the host name, which
# in an add-on is "<repository hash>-claude-code".
options+=(--remote-control-session-name-prefix "${session_name}")
bashio::debug && options+=(--verbose)

# same-dir rather than worktree: the configuration directory is not a git
# repository, and every session is meant to share it.
cd /config || bashio::exit.nok 'Working directory /config is not available'

bashio::log.info "Starting Remote Control as \"${session_name}\"..."

# exec keeps Claude Code the process s6 supervises and signals; only its
# standard output takes the detour through the filter.
exec claude remote-control "${options[@]}" > >(filter_remote_control_output)
