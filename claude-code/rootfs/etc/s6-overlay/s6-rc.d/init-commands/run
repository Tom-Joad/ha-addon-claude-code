#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Add-on: Claude Code
# Executes user configured commands on startup
# ==============================================================================
declare length
declare cmd
declare status
declare idx

bashio::config.has_value 'init_commands' || exit 0

length=$(bashio::config 'init_commands | length') \
    || bashio::exit.nok 'Failed to read the init_commands list'

for (( idx=0; idx<length; idx++ )); do
    cmd=$(bashio::config "init_commands[${idx}]") \
        || bashio::exit.nok "Failed to read init command at index ${idx}"

    # Logged by position only: a command may carry a credential (a token in a
    # git URL or an Authorization header), and the add-on log is shown in the
    # UI, included in diagnostics and pasted into bug reports.
    bashio::log.info "Running init command $((idx + 1)) of ${length}"

    # A failing init command is logged but does not stop the add-on. Locking
    # yourself out of the terminal over a typo in an init command would leave no
    # way to fix the init command.
    #
    # Each command runs in a child shell: this script runs with errexit and
    # nounset, so an unset variable or an "exit" inside the command would end
    # the whole service (and ttyd waits for it), and the command could overwrite
    # the loop's own variables.
    status=0
    bash -c "${cmd}" || status=$?
    if (( status != 0 )); then
        bashio::log.warning \
            "Init command $((idx + 1)) of ${length} failed (exit code ${status})"
    fi
done
